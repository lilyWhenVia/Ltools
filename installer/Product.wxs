<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Ltools" Language="1033" Version="0.1.3" Manufacturer="lilyWhenVia" UpgradeCode="C0F13C5D-445B-46D1-B250-9BA44A5C915D">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" Description="Ltools Windows launcher and local clipboard history" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Ltools is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LtoolsIcon" SourceFile="$(var.PayloadDir)\Ltools.ico" />
    <Property Id="ARPPRODUCTICON" Value="LtoolsIcon" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lilyWhenVia/Ltools" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.PayloadDir)\License.rtf" />
    <UIRef Id="WixUI_Minimal" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Ltools">
            <Component Id="App" Guid="7C2C478D-4EAA-4C2D-8E94-FC03801C8D28" Win64="yes">
              <File Id="LtoolsExe" Source="$(var.PayloadDir)\Ltools.exe" />
              <RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="App" Type="string" Value="0.1.3" KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" /><RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
            </Component>
            <Component Id="Config" Guid="EAA33110-2B06-4A49-94DA-601FBFD4DD71" Win64="yes"><File Id="ConfigFile" Source="$(var.PayloadDir)\Ltools.exe.config" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Config" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
            <Component Id="License" Guid="967E2DE5-E62A-454A-B48E-4F17C3BD022B" Win64="yes"><File Id="LicenseFile" Source="$(var.PayloadDir)\LICENSE" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="License" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
            <Component Id="Notice" Guid="B9283CB1-7977-4798-B2A7-1B44F6BBF458" Win64="yes"><File Id="NoticeFile" Source="$(var.PayloadDir)\NOTICE" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Notice" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
            <Component Id="Readme" Guid="BBC04BE9-9819-4787-B66C-71A92CA07A8C" Win64="yes"><File Id="ReadmeFile" Source="$(var.PayloadDir)\README.md" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Readme" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
            <Component Id="Privacy" Guid="DC42133C-3653-4EDF-A304-D571C0E144C7" Win64="yes"><File Id="PrivacyFile" Source="$(var.PayloadDir)\PRIVACY.md" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Privacy" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
            <Component Id="Security" Guid="B33B3716-D086-43E6-B753-11FC8908AF65" Win64="yes"><File Id="SecurityFile" Source="$(var.PayloadDir)\SECURITY_REVIEW.md" /><RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Security" Type="string" Value="0.1.3" KeyPath="yes" /></Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MenuDir" Name="Ltools">
          <Component Id="MenuShortcut" Guid="E26F761A-699F-4640-ABD8-27DE92E80A1A" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Name="Ltools" Target="[INSTALLFOLDER]Ltools.exe" WorkingDirectory="INSTALLFOLDER" Icon="LtoolsIcon" IconIndex="0" />
            <RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Menu" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="59ACB96E-D63C-4982-8FF0-B6FD435FDC94" Win64="yes">
          <Shortcut Id="DesktopLink" Name="Ltools" Target="[INSTALLFOLDER]Ltools.exe" WorkingDirectory="INSTALLFOLDER" Icon="LtoolsIcon" IconIndex="0" />
          <RegistryValue Root="HKCU" Key="Software\Ltools\Installer" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="MainFeature" Title="Ltools" Level="1">
      <ComponentRef Id="App" /><ComponentRef Id="Config" /><ComponentRef Id="License" /><ComponentRef Id="Notice" /><ComponentRef Id="Readme" /><ComponentRef Id="Privacy" /><ComponentRef Id="Security" /><ComponentRef Id="MenuShortcut" /><ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
